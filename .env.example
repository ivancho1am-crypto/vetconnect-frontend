# Veterinario Alfa Latinoamérica — Variables de entorno
# Copia este archivo a .env y completa los valores reales
# NUNCA subas .env a GitHub

# Node
NODE_ENV=production

# Puerto (Railway lo define automáticamente)
PORT=3000

# Nodo regional activo — valores: latam | co | ec | pe | ve | mx | es | otros
NODE_ID=latam

# Supabase (solo para referencia — las claves anon están en el HTML del cliente)
# La service_role key NO va aquí, va en Supabase Edge Functions secrets
SUPABASE_URL=https://xpjjolrznelyejflctvh.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=  ← Solo para scripts de migración locales

# Sentry — monitoreo de errores en producción
# Obtén el DSN en: sentry.io → Settings → Projects → Client Keys
SENTRY_DSN=

# WordPress Email API (endpoint personalizado)
WP_EMAIL_URL=https://www.vitalvetcrv.com.co/wp-json/vitalvet/v1/send-email
WP_API_KEY=vc2026
